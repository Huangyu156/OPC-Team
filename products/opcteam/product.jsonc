{
  "$schema": "../schemas/product-definition.schema.json",
  "schemaVersion": 1,
  // Data identity is the OPC-Team identity: new stores, the product home
  // directory, and the project-local data directory all use the opcteam
  // namespace and its `.opcteam` hidden directory.
  "productId": "opcteam",
  "dataNamespace": "opcteam",
  "localeRoot": "./locales",
  "members": {
    "desktop": {
      "displayNameKey": "product.desktop.name",
      // Install and upgrade identity moves to the OPC-Team values together with
      // this rename: the signed bundles, OS install records, and store listings
      // are re-issued under the new identity, and the legacy data migrator
      // carries existing user data across the namespace switch.
      "binaryName": "opc-desktop",
      "bundleId": "com.opcteam.desktop"
    },
    "cli": {
      "displayNameKey": "product.cli.name",
      // The CLI executable is published as `opc`; the legacy data migrator
      // handles installs that still have the retired name on PATH.
      "binaryName": "opc"
    }
  }
}
