{
  "app": {
    // Package identity is intentionally stable across the OPC-Team rename so
    // upgrades retain encrypted sessions, preferences, and watch handoff data.
    "bundleName": "com.opcteam.app",
    "vendor": "OPC-Team",
    "versionCode": 8,
    "versionName": "1.0.0", // x-release-please-version
    "buildVersion": "1",
    "icon": "$media:opc_app_icon",
    "label": "$string:app_name",
    "configuration": "$profile:configuration"
  }
}
